{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story Intake",
  "type": "object",
  "required": [
    "storyId",
    "title",
    "sourceType",
    "genre",
    "scope"
  ],
  "properties": {
    "storyId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "sourceType": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "authenticityLevel": {
      "type": "string"
    },
    "adaptationType": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
